@@ -0,0 +1,73 @@
+package moe.ouom.neriplayer.ui.tv
+
+/*
+ * NeriPlayer - A unified Android player for streaming music and videos from multiple online platforms.
+ * Copyright (C) 2025-2025 NeriPlayer developers
