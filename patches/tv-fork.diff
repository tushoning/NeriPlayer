diff --git a/fork-tools/make-patches.sh b/fork-tools/make-patches.sh
new file mode 100644
index 00000000..f41e8b00
--- /dev/null
+++ b/fork-tools/make-patches.sh
@@ -0,0 +1,160 @@
+#!/usr/bin/env bash
+# ---------------------------------------------------------------------------
+# 生成「我方改动 vs 上游」补丁快照
+#
+#   bash fork-tools/make-patches.sh [上游基线]
+#
+# 不传基线时默认取 origin/master 与 HEAD 的 merge-base。
+#
+# 前置约定：main 分支必须是「线性」的（没有 merge commit），
+# 否则拆分出的补丁链无法逐个 git am。见 FORK.md「为什么分支必须线性」。
+#
+# 产物：
+#   patches/tv-fork.diff              单个合并补丁（日常同步用这个，冲突一次解决完）
+#   patches/series/NNNN-<sha>.patch   按提交拆分的补丁链（git am / 回看历史用）
+#   patches/BASE                      基线 commit 信息
+# ---------------------------------------------------------------------------
+set -euo pipefail
+
+REPO_ROOT=$(git rev-parse --show-toplevel)
+cd "$REPO_ROOT"
+
+# 上游分支自动识别：
+#   fork 仓库里 upstream = cwuom/NeriPlayer，origin = 自己
+#   老的工作副本里 origin 直接就是上游
+if [ -z "${1:-}" ]; then
+  UPSTREAM_REF=""
+  for cand in upstream/master origin/master; do
+    if git rev-parse --verify --quiet "$cand" >/dev/null 2>&1; then
+      UPSTREAM_REF=$cand
+      break
+    fi
+  done
+  if [ -z "$UPSTREAM_REF" ]; then
+    echo "找不到上游分支。先执行：" >&2
+    echo "  git remote add upstream https://github.com/cwuom/NeriPlayer.git" >&2
+    echo "  git fetch upstream master" >&2
+    exit 1
+  fi
+fi
+BASE=${1:-$(git merge-base "$UPSTREAM_REF" HEAD)}
+BASE_FULL=$(git rev-parse "$BASE")
+BASE_SHA=$(git rev-parse --short "$BASE")
+BASE_SUBJECT=$(git log -1 --format=%s "$BASE")
+HEAD_SHA=$(git rev-parse --short HEAD)
+
+# patches/ 自身不参与补丁内容，否则补丁会包含自己
+FILTER=(-- . ':(exclude)patches')
+
+if [ -n "$(git rev-list --merges "$BASE..HEAD")" ]; then
+  echo "警告：$BASE_SHA..HEAD 之间还有 merge commit，补丁链可能无法逐个应用。" >&2
+  echo "      执行 git rebase $BASE_SHA 把它变线性后再跑本脚本。" >&2
+fi
+
+# 代码 tip：最后一个不是「只动 patches/」的提交。
+# 用 HEAD 会导致每次刷新快照后 BASE 里的 tip_sha 都变，产生无意义的 diff。
+mapfile -t COMMITS < <(git rev-list --reverse --no-merges --topo-order "$BASE_FULL..HEAD" "${FILTER[@]}")
+if [ "${#COMMITS[@]}" -eq 0 ]; then
+  echo "补丁为空：当前分支和 $BASE_SHA 没有差异。" >&2
+  exit 1
+fi
+CODE_TIP=$(git rev-parse --short "${COMMITS[${#COMMITS[@]}-1]}")
+CODE_TIP_SUBJECT=$(git log -1 --format=%s "${COMMITS[${#COMMITS[@]}-1]}")
+
+echo "基线: $BASE_SHA  $BASE_SUBJECT"
+echo "tip : $CODE_TIP  $CODE_TIP_SUBJECT（共 ${#COMMITS[@]} 个提交）"
+
+# patches/ 会整个重建，但里面的说明文档要保留
+KEEP_README=""
+[ -f patches/README.md ] && KEEP_README=$(cat patches/README.md)
+
+rm -rf patches
+mkdir -p patches/series
+[ -n "$KEEP_README" ] && printf '%s\n' "$KEEP_README" > patches/README.md
+
+# ---- 1. 单个合并补丁 ------------------------------------------------------
+{
+  printf '%s\n' \
+    "# NeriPlayer TV fork — 相对上游的完整改动（单个合并补丁）" \
+    "# 基线 upstream commit : $BASE_SHA  ($BASE_SUBJECT)" \
+    "# 我方 tip             : $CODE_TIP  ($CODE_TIP_SUBJECT)" \
+    "# 生成命令             : bash fork-tools/make-patches.sh $BASE_SHA" \
+    "# 应用                 : git apply -3 patches/tv-fork.diff" \
+    ""
+  git diff "$BASE_FULL" HEAD "${FILTER[@]}"
+} > patches/tv-fork.diff
+
+# ---- 2. 按提交拆分的补丁链 ------------------------------------------------
+# 必须给 format-patch 也带上 pathspec：否则会把提交里对 patches/（快照自己）的改动
+# 一起写进补丁，重放时和自己打架。
+i=1
+for c in "${COMMITS[@]}"; do
+  sha=$(git rev-parse --short "$c")
+  out="patches/series/$(printf '%04d' $i)-$sha.patch"
+  git format-patch -1 --no-signature --stdout "$c" "${FILTER[@]}" > "$out"
+  # 只动了 patches/ 的提交，过滤后没有 diff，丢掉
+  if ! grep -q "^diff --git " "$out"; then
+    rm -f "$out"
+    echo "跳过 $sha（只动了 patches/）"
+    continue
+  fi
+  i=$((i + 1))
+done
+
+cat > patches/BASE <<EOF
+base_sha=$BASE_SHA
+base_full_sha=$BASE_FULL
+base_subject=$BASE_SUBJECT
+tip_sha=$CODE_TIP
+commits=${#COMMITS[@]}
+EOF
+
+echo "合并补丁: $(wc -l < patches/tv-fork.diff) 行"
+echo "补丁链  : ${#COMMITS[@]} 个"
+
+# ---- 3. 自检：临时 worktree 里重放，确认能精确还原 ------------------------
+TMPROOT=$(mktemp -d)
+WT="$TMPROOT/verify"
+git worktree add -q --detach "$WT" "$BASE_FULL"
+cleanup() {
+  git worktree remove --force "$WT" >/dev/null 2>&1 || true
+  rm -rf "$TMPROOT" >/dev/null 2>&1 || true
+}
+trap cleanup EXIT
+
+(
+  cd "$WT"
+  git apply -3 "$REPO_ROOT/patches/tv-fork.diff"
+  git add -A
+  git -c user.name=verify -c user.email=verify@local commit -qm verify
+  git rev-parse HEAD^{tree} > "$TMPROOT/squash.tree"
+)
+(
+  cd "$WT"
+  git reset -q --hard "$BASE_FULL"
+  git clean -qfdx
+  git am -3 --keep-cr "$REPO_ROOT"/patches/series/*.patch >/dev/null
+  git rev-parse HEAD^{tree} > "$TMPROOT/series.tree"
+)
+
+# 期望树：HEAD 去掉 patches/（patches/ 是补丁自身的快照，不属于被补丁内容）
+export GIT_INDEX_FILE="$TMPROOT/idx"
+git read-tree HEAD
+if [ -n "$(git ls-tree HEAD -- patches)" ]; then
+  git rm -r -q --cached patches
+fi
+TIP_TREE=$(git write-tree)
+unset GIT_INDEX_FILE
+
+SQUASH_TREE=$(cat "$TMPROOT/squash.tree")
+SERIES_TREE=$(cat "$TMPROOT/series.tree")
+
+echo "tip tree    : $TIP_TREE"
+echo "squash tree : $SQUASH_TREE"
+echo "series tree : $SERIES_TREE"
+if [ "$SQUASH_TREE" = "$TIP_TREE" ] && [ "$SERIES_TREE" = "$TIP_TREE" ]; then
+  echo "自检通过：两种补丁都能精确还原我方代码"
+else
+  echo "自检失败：补丁与当前代码不一致" >&2
+  exit 1
+fi
diff --git a/fork-tools/sync-upstream.sh b/fork-tools/sync-upstream.sh
new file mode 100644
index 00000000..bed4bf2e
--- /dev/null
+++ b/fork-tools/sync-upstream.sh
@@ -0,0 +1,122 @@
+#!/usr/bin/env bash
+# ---------------------------------------------------------------------------
+# 上游更新后，把我方改动重新落到新上游上
+#
+#   bash fork-tools/sync-upstream.sh              # 用补丁链（保留每个提交）
+#   bash fork-tools/sync-upstream.sh --squash     # 用单个合并补丁（冲突一次解决）
+#   bash fork-tools/sync-upstream.sh --build      # 同步完顺便编译电视包
+#
+# 成功 → 当前分支变成「新上游 + 我方补丁」。
+# 冲突 → 停下来，工作区保留 <<<<<<< 标记，手工改完 git add + git am --continue。
+# ---------------------------------------------------------------------------
+set -euo pipefail
+
+REPO_ROOT=$(git rev-parse --show-toplevel)
+cd "$REPO_ROOT"
+
+MODE=series
+DO_BUILD=0
+for arg in "$@"; do
+  case "$arg" in
+    --squash) MODE=squash ;;
+    --build)  DO_BUILD=1 ;;
+    *) echo "未知参数: $arg" >&2; exit 2 ;;
+  esac
+done
+
+[ -f patches/tv-fork.diff ] || { echo "找不到 patches/tv-fork.diff，先跑 fork-tools/make-patches.sh" >&2; exit 1; }
+if [ -n "$(git status --porcelain)" ]; then
+  echo "工作区不干净，先提交或 stash：" >&2
+  git status --short >&2
+  exit 1
+fi
+
+# 上游远端自动识别
+UPSTREAM_REMOTE=""
+for r in upstream origin; do
+  url=$(git remote get-url "$r" 2>/dev/null || true)
+  case "$url" in
+    *cwuom/NeriPlayer*) UPSTREAM_REMOTE=$r; break ;;
+  esac
+done
+if [ -z "$UPSTREAM_REMOTE" ]; then
+  echo "找不到上游远端。先执行：" >&2
+  echo "  git remote add upstream https://github.com/cwuom/NeriPlayer.git" >&2
+  exit 1
+fi
+
+echo "== 拉取上游（$UPSTREAM_REMOTE）=="
+git fetch --quiet "$UPSTREAM_REMOTE" master
+NEW_UPSTREAM=$(git rev-parse "$UPSTREAM_REMOTE/master")
+OLD_BASE=$(sed -n 's/^base_full_sha=//p' patches/BASE)
+echo "补丁基线: $(git rev-parse --short "$OLD_BASE")"
+echo "新上游  : $(git rev-parse --short "$NEW_UPSTREAM")  $(git log -1 --format=%s "$NEW_UPSTREAM")"
+
+if git merge-base --is-ancestor "$NEW_UPSTREAM" "$OLD_BASE"; then
+  echo "上游没有新提交，无需同步。"
+  exit 0
+fi
+
+BRANCH="sync/$(date +%Y%m%d-%H%M)"
+git checkout -B "$BRANCH" "$NEW_UPSTREAM"
+
+echo
+echo "== 应用我方改动（$MODE）=="
+set +e
+if [ "$MODE" = squash ]; then
+  git apply -3 patches/tv-fork.diff
+  RC=$?
+else
+  git am -3 --keep-cr patches/series/*.patch
+  RC=$?
+fi
+set -e
+
+if [ "$RC" -ne 0 ]; then
+  cat <<'EOF'
+
+------------------------------------------------------------------
+冲突了。这不是失败，是上游动到了我们改过的地方。
+
+处理方式：
+  git status                  # 看 <<<<<<< ======= >>>>>>> 标记
+  ...编辑冲突文件...
+  git add <文件>
+  git am --continue           # （--squash 模式改成 git commit）
+
+想全部放弃重来：
+  git am --abort              # （--squash 模式：git checkout -- . && git clean -fd）
+  git checkout main
+
+常见冲突点的处理原则：
+  1. import 冲突      → 取并集
+  2. 上游只是改名（CoreCommonR→AppR 之类）→ 取我方，再全局改名
+  3. 上游真重构了     → 取上游，再把我们的 TV 逻辑补回去
+------------------------------------------------------------------
+EOF
+  exit 1
+fi
+
+if [ "$MODE" = squash ]; then
+  git add -A
+  git commit -qm "feat(tv): 同步上游 $(git rev-parse --short "$NEW_UPSTREAM") 并叠加 TV 改动"
+fi
+
+echo
+echo "== 同步完成 =="
+git log --oneline "$NEW_UPSTREAM"..HEAD | head -10
+
+if [ "$DO_BUILD" = 1 ]; then
+  echo
+  echo "== 编译电视包 =="
+  export TMPDIR="$REPO_ROOT/build/tmp"
+  export TEMP="$TMPDIR"
+  export TMP="$TMPDIR"
+  mkdir -p "$TMPDIR"
+  ./gradlew :app:assembleTvrelease
+fi
+
+echo
+echo "下一步："
+echo "  bash fork-tools/make-patches.sh        # 把基线更新成新上游"
+echo "  git checkout main && git reset --hard $BRANCH && git push -f origin main"
