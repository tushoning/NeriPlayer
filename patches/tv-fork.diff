+        name = title,
+        artist = uploader,
+        album = buildBiliSongAlbum(bvid = bvid),
+        albumId = 0L,
+        durationMs = durationSec * 1000L,
+        coverUrl = coverUrl,
+        channelId = "bilibili",
+        audioId = id.toString()
+    )
 }
 
