+/**
+ * 电视上的「更多」面板：一层无动画的全屏覆盖 + 底部固定面板。
+ * 除了去掉弹层动画，它也不参与任何手势/嵌套滚动，方向键移动焦点时面板不会跟着位移。
+ */
+@Composable
+private fun TvMoreOptionsSurface(
+    owner: MoreOptionsSheetOwner,
+    snackbarHostState: SnackbarHostState,
+    content: @Composable () -> Unit
+) {
+    val scrimInteraction = remember { MutableInteractionSource() }
+    // 从三个点按钮下方往左下展开：贴屏幕右上角，高度跟着内容走，最多到屏幕 82%。
+    val maxSheetHeight = LocalConfiguration.current.screenHeightDp.dp * 0.82f
+    LaunchedEffect(Unit) {
+        repeat(8) {
+            val focused = runCatching {
+                TvMoreOptionsFocus.firstItem.requestFocus()
+            }.getOrDefault(false)
+            if (focused) return@LaunchedEffect
+            withFrameNanos { }
+        }
+    }
+    BackHandler {
+        if (owner.isEditSongSaving) return@BackHandler
+        if (owner.page != MoreOptionsPage.MAIN) owner.back() else owner.onDismissRequest()
+    }
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .zIndex(100f)
+            // 电视：把焦点关在这块遮罩里。
+            //
+            // 这一层和下面的播放控件是**同一个窗口、同一个组合**（zIndex 只管绘制顺序），
+            // 没有焦点边界的话，Compose 的方向搜索是全局几何搜索，会把光标直接送进
+            // 被遮住的播放键/进度条上。外层浮层的 onExit 只拦「离开整个浮层」，
+            // 拦不住浮层内部兄弟子树之间的移动。
+            .focusGroup()
+            .focusProperties {
+                // 这一层只当边界用，本身不是可聚焦目标
+                canFocus = false
+                // 想跑出去就原地取消 —— 方向键到面板边缘就停住
+                onExit = { cancelFocusChange() }
+            }
+            .focusTarget()   // 必须：只有真正进焦点树的节点才会收到 onExit 回调
+    ) {
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(Color.Black.copy(alpha = 0.52f))
+                // clickable 自带 focusable，不摘掉的话这块全屏遮罩会变成一个
+                // 「有焦点环、什么都没有」的落点。必须写在 clickable 之前。
+                .focusProperties { canFocus = false }
+                .clickable(interactionSource = scrimInteraction, indication = null) {
+                    owner.onDismissRequest()
+                }
+        )
+        Surface(
+            modifier = Modifier
+                .align(Alignment.TopEnd)
+                .padding(top = 72.dp, end = 28.dp)
+                .fillMaxWidth(0.34f)
+                .widthIn(max = 560.dp)
+                .heightIn(max = maxSheetHeight)
+                .wrapContentHeight(),
+            shape = RoundedCornerShape(20.dp),
+            color = MaterialTheme.colorScheme.surface
+        ) {
+            MoreOptionsSheetBody(owner.page, snackbarHostState, content)
+        }
+    }
+}
