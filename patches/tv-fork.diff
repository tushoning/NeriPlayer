+        .tvBringIntoViewOnFocus()
+        // 电视：设置条目都是整行占满宽度，最左边再按左会穿到页面外面，
+        // 被方向搜索一路带到顶部主标签栏上（「按左就跳到标签页」）
+        .tvClampLeft()
+        .clickable(
