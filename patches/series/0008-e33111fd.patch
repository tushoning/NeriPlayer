From e33111fd2fd66d815adc7d272da9749dbf5ff3c7 Mon Sep 17 00:00:00 2001
From: local <local@work>
Date: Mon, 2 Nov 2026 10:21:59 +0800
Subject: [PATCH] perf(tv): skip the hardcoded 300ms dual-scene host transition
 on television

---
 .../ui/screen/host/ExploreHostScreen.kt       |  9 ++++++++-
 .../ui/screen/host/HomeHostScreen.kt          |  9 ++++++++-
 .../ui/screen/host/LibraryHostScreen.kt       |  9 ++++++++-
 .../ui/screen/host/SettingsHostScreen.kt      | 20 ++++++++++++++-----
 4 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/screen/host/ExploreHostScreen.kt b/app/src/main/java/moe/ouom/neriplayer/ui/screen/host/ExploreHostScreen.kt
index 51711205..cdd718fe 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/screen/host/ExploreHostScreen.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/screen/host/ExploreHostScreen.kt
@@ -286,6 +286,9 @@ fun ExploreHostScreen(
         )
 
     Surface(modifier = Modifier.fillMaxSize(), color = Color.Transparent) {
+    // 电视：整页转场（300ms、双场景、reveal 裁剪 + 缩放重测）在弱 GPU/弱 CPU 上是
+    // 「切页面卡一下」的主要来源，且没人要求电视上有这个动效。
+    val tvSkipSceneMotion = moe.ouom.neriplayer.ui.tv.LocalIsTelevision.current
         navigationTransition.AnimatedContent(
             modifier = Modifier.fillMaxSize(),
             contentKey = { item ->
@@ -296,7 +299,11 @@ fun ExploreHostScreen(
                 }
             },
             transitionSpec = {
-                if (
+                if (tvSkipSceneMotion) {
+
+                    EnterTransition.None togetherWith ExitTransition.None
+
+                } else if (
                     shouldSuppressRestoredMainTabHostEntry(
                         restoredEntry = suppressRestoredSceneEntry,
                         initialDepth = initialState.navigationDepth,
