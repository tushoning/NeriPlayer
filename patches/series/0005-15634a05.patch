@@ -158,7 +158,14 @@ private fun BouncingSongTitle(
 }
 
 private fun Modifier.horizontalTitleEdgeFade(fadeWidth: Dp): Modifier = this
-    .graphicsLayer { compositingStrategy = CompositingStrategy.Offscreen }
+    .graphicsLayer {
+        // 电视：不要离屏图层（见 TvPerf.disableOffscreenMasks）
+        compositingStrategy = if (moe.ouom.neriplayer.ui.tv.TvPerf.disableOffscreenMasks) {
+            CompositingStrategy.Auto
+        } else {
+            CompositingStrategy.Offscreen
+        }
+    }
     .drawWithCache {
         val edge = (fadeWidth.toPx() / size.width).coerceIn(0f, 0.22f)
         val brush = if (edge > 0f) {
@@ -177,7 +184,8 @@ private fun Modifier.horizontalTitleEdgeFade(fadeWidth: Dp): Modifier = this
         }
         onDrawWithContent {
             drawContent()
-            if (brush != null) {
+            // 电视上没有离屏图层，DstIn 会直接擦掉父容器的内容，必须跳过
+            if (brush != null && !moe.ouom.neriplayer.ui.tv.TvPerf.disableOffscreenMasks) {
                 drawRect(
                     brush = brush,
                     size = size,
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/screen/lyrics/LyricsScreen.kt b/app/src/main/java/moe/ouom/neriplayer/ui/screen/lyrics/LyricsScreen.kt
index fa4e75cc..b5aedb95 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/screen/lyrics/LyricsScreen.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/screen/lyrics/LyricsScreen.kt
@@ -343,8 +343,11 @@ fun LyricsScreen(
     val durationMs = currentSong?.durationMs ?: 0L
 
     val context = LocalContext.current
-    val lowPowerLyricsRendering = remember(context) {
-        context.isSystemPowerSaveMode()
+    // 电视：无条件走低功耗歌词渲染（关加色混合、拉长帧格、减模糊）。
+    // 这个开关本来就是给弱设备准备的，只是原来只认系统省电模式。
+    val tvLyricsLowPower = LocalIsTelevision.current
+    val lowPowerLyricsRendering = remember(context, tvLyricsLowPower) {
+        context.isSystemPowerSaveMode() || tvLyricsLowPower
     }
     val currentCoverUrl = rememberSongDisplayCoverUrl(currentSong)
     val clipboard = LocalClipboard.current
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/screen/nowplaying/NowPlayingScreen.kt b/app/src/main/java/moe/ouom/neriplayer/ui/screen/nowplaying/NowPlayingScreen.kt
