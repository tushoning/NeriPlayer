         val resolvedFadeWidth = fadeWidth.toPx().coerceAtMost(size.width / 2f)
         if (resolvedFadeWidth <= 0f) return@drawWithContent
         if (showStartFade) {
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt b/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt
index 649c8650..cb12c153 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt
@@ -165,6 +165,7 @@ fun NeriTheme(
             SideEffect {
                 TvPerf.reduceMotion = isTelevision
                 TvPerf.disableBlur = isTelevision
+                TvPerf.disableOffscreenMasks = isTelevision
             }
             // Material3 的组件（Surface/Card/Button/列表项）内部硬写 ripple()，不读 LocalIndication，
             // 所以额外把 ripple 的焦点态叠加强化，否则电视上看不出光标停在哪
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/tv/TvPerformance.kt b/app/src/main/java/moe/ouom/neriplayer/ui/tv/TvPerformance.kt
index af09d22d..b14eecef 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/tv/TvPerformance.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/tv/TvPerformance.kt
@@ -39,4 +39,15 @@ object TvPerf {
     /** 关掉玻璃模糊取样 */
     @Volatile
     var disableBlur: Boolean = false
+
+    /**
+     * 关掉「离屏图层 + DstIn 渐变遮罩」这类边缘渐隐装饰。
+     *
+     * 它的实现是 `compositingStrategy = Offscreen` + `BlendMode.DstIn`：内容要先整块渲染进
+     * 一张离屏纹理，再拿渐变去混合一次。手机上有 GPU 分块（tile）和充足带宽，几乎不花钱；
+     * 电视盒子（尤其 1080p 大面积的歌词区域）每帧都要多分配、多写、多读一张全程纹理，
+     * 是这批装饰里最贵的一档，比模糊更贵，因为它不依赖 Android 12 的 RenderEffect。
+     */
+    @Volatile
+    var disableOffscreenMasks: Boolean = false
 }
