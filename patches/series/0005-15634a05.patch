From 15634a05b58c1518751f1ee15e57f49c1c986cc3 Mon Sep 17 00:00:00 2001
From: local <local@work>
Date: Mon, 2 Nov 2026 09:05:46 +0800
Subject: [PATCH] perf(tv): drop offscreen DstIn edge fades and per-line
 karaoke layers; force low-power lyric rendering

---
 .../ui/component/common/CleanSegmentedTabs.kt | 10 ++++-
 .../ui/component/lyrics/AdvancedLyricsView.kt |  3 +-
 .../ui/component/lyrics/SyncedLyricsView.kt   | 37 +++++++++++++++----
 .../component/playback/NowPlayingSongTitle.kt | 12 +++++-
 .../ui/screen/lyrics/LyricsScreen.kt          |  7 +++-
 .../ui/screen/nowplaying/NowPlayingScreen.kt  |  6 ++-
 .../ui/screen/tab/explore/ExploreScreen.kt    | 10 ++++-
 .../moe/ouom/neriplayer/ui/theme/NeriTheme.kt |  1 +
 .../ouom/neriplayer/ui/tv/TvPerformance.kt    | 11 ++++++
 9 files changed, 81 insertions(+), 16 deletions(-)

diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/component/common/CleanSegmentedTabs.kt b/app/src/main/java/moe/ouom/neriplayer/ui/component/common/CleanSegmentedTabs.kt
index b38c4995..e4739382 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/component/common/CleanSegmentedTabs.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/component/common/CleanSegmentedTabs.kt
@@ -237,9 +237,17 @@ private val EdgeFadeWidth = 28.dp
  * ease in and out as the row reaches either end without recomposing the row.
  */
 private fun Modifier.softHorizontalEdgeFade(startFade: () -> Float, endFade: () -> Float): Modifier =
-    graphicsLayer { compositingStrategy = CompositingStrategy.Offscreen }
+    graphicsLayer {
+        // 电视：不要离屏图层（见 TvPerf.disableOffscreenMasks）
+        compositingStrategy = if (moe.ouom.neriplayer.ui.tv.TvPerf.disableOffscreenMasks) {
+            CompositingStrategy.Auto
+        } else {
+            CompositingStrategy.Offscreen
+        }
+    }
         .drawWithContent {
             drawContent()
+            if (moe.ouom.neriplayer.ui.tv.TvPerf.disableOffscreenMasks) return@drawWithContent
             val width = EdgeFadeWidth.toPx().coerceAtMost(size.width / 2f)
             val start = startFade().coerceIn(0f, 1f)
             val end = endFade().coerceIn(0f, 1f)
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/AdvancedLyricsView.kt b/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/AdvancedLyricsView.kt
index fc5b7110..f7f93eeb 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/AdvancedLyricsView.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/AdvancedLyricsView.kt
@@ -172,7 +172,8 @@ fun AdvancedLyricsView(
                 modifier = Modifier
                     .fillMaxSize()
                     .then(
-                        if (useAdditiveBlend) {
+                        // 电视：加色混合要把整个歌词区先离屏渲染再 Plus 混合，是最贵的一档
+                        if (useAdditiveBlend && !LocalIsTelevision.current) {
                             Modifier.graphicsLayer {
                                 blendMode = BlendMode.Plus
                                 compositingStrategy = CompositingStrategy.Offscreen
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt b/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt
index d894ddfc..bdd605f0 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt
@@ -552,14 +552,23 @@ private fun rememberSmoothedLyricTimeMs(
 
 /** 上下渐隐 */
 fun Modifier.verticalEdgeFade(fadeHeight: Dp): Modifier = this
-    .graphicsLayer { compositingStrategy = CompositingStrategy.Offscreen }
+    .graphicsLayer {
+        // 电视：不要离屏图层（见 TvPerf.disableOffscreenMasks）
+        compositingStrategy = if (TvPerf.disableOffscreenMasks) {
+            CompositingStrategy.Auto
+        } else {
+            CompositingStrategy.Offscreen
+        }
+    }
     .drawWithCache {
         // 遮罩只随尺寸变化，滚动和逐帧重绘时复用同一个渐变
         val edge = (fadeHeight.toPx() / size.height).coerceIn(0f, 0.44f)
         val brush = if (edge > 0f) verticalEdgeFadeBrush(edge) else null
         onDrawWithContent {
             drawContent()
-            if (brush != null) drawRect(brush = brush, size = size, blendMode = BlendMode.DstIn)
+            if (brush != null && !TvPerf.disableOffscreenMasks) {
+                drawRect(brush = brush, size = size, blendMode = BlendMode.DstIn)
+            }
         }
     }
 
@@ -621,6 +630,9 @@ fun SyncedLyricsView(
     stableEmbeddedViewport: Boolean = false,
     bilingualDisplayEnabled: Boolean = true
 ) {
+    // 电视：上下渐隐用的是 compositingStrategy=Offscreen + DstIn，等于把整个歌词视口
+    // 每帧先渲染到一张离屏纹理再混合。歌词本来就逐帧刷新，这一层是播放页/歌词页最贵的开销。
+    val tvNoEdgeFade = LocalIsTelevision.current
     val translationMatchesByIndex = remember(lyrics, translatedLyrics) {
         matchTranslationsToLineIndices(
             lines = lyrics,
@@ -766,7 +778,7 @@ fun SyncedLyricsView(
             horizontalAlignment = Alignment.CenterHorizontally,
             modifier = Modifier
                 .fillMaxSize()
-                .verticalEdgeFade(fadeHeight = edgeFadeHeight)
+                .then(if (tvNoEdgeFade) Modifier else Modifier.verticalEdgeFade(fadeHeight = edgeFadeHeight))
         ) {
             itemsIndexed(
                 items = displayLyrics,
@@ -1294,7 +1306,10 @@ fun SyncedLyricsActiveLine(
         playbackSpeed = playbackSpeed
     )
     val targetLyricTimeMs = (currentTimeMs + lyricOffsetMs).coerceAtLeast(0L)
-    val smoothedLyricTimeMs = if (animateProgress) {
+    // 电视：不做逐帧平滑。这个平滑循环每帧写一次 state，会把每一行歌词每帧重绘一遍，
+    // 是播放页在低端盒子上「一直卡」的根源之一。
+    val tvStaticReveal = LocalIsTelevision.current
+    val smoothedLyricTimeMs = if (animateProgress && !tvStaticReveal) {
         rememberSmoothedLyricTimeMs(targetLyricTimeMs)
     } else {
         targetLyricTimeMs
@@ -1365,14 +1380,18 @@ fun SyncedLyricsActiveLine(
         )
 
         // 高亮文本 - 仅在布局准备好后渲染, 避免旧数据导致的异常
-        if (isLayoutReady) {
+        // 电视：逐字擦除（multilineGradientReveal）会为**每一行**建一张离屏图层再做 DstIn 混合，
+        // 十几行叠在一起每帧重混一次，是这个页面最重的地方。电视上只有「正在唱的这一行」保留
+        // 逐字推进（最多一两张图层），已经唱完的行直接整行上高亮色。
+        if (isLayoutReady && (!tvStaticReveal || progressTarget > 0f)) {
+            val needsReveal = !tvStaticReveal || progressTarget < 1f
             Text(
                 text = line.text,
                 style = textStyle.copy(color = activeColor),
                 maxLines = Int.MAX_VALUE,
                 softWrap = true,
-                modifier = Modifier
-                    .multilineGradientReveal(
+                modifier = (if (needsReveal) {
+                    Modifier.multilineGradientReveal(
                         layout = layout,
                         revealOffsetChars = revealOffsetChars,
                         textLength = line.text.length,
@@ -1387,7 +1406,9 @@ fun SyncedLyricsActiveLine(
                         horizontalContentInset = revealHorizontalPadding,
                         parallelParagraphs = parallelParagraphs
                     )
-                    .padding(horizontal = revealHorizontalPadding)
+                } else {
+                    Modifier
+                }).padding(horizontal = revealHorizontalPadding)
             )
         }
     }
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/component/playback/NowPlayingSongTitle.kt b/app/src/main/java/moe/ouom/neriplayer/ui/component/playback/NowPlayingSongTitle.kt
