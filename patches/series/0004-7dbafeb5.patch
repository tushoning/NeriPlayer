From 7dbafeb5ce6a90d57d69346569bbb2060483dd53 Mon Sep 17 00:00:00 2001
From: local <local@work>
Date: Mon, 2 Nov 2026 08:45:54 +0800
Subject: [PATCH] perf(tv): zero lyric line blur, instant lyric autoscroll,
 instant now-playing<->lyrics switch

---
 .../ui/component/lyrics/SyncedLyricsView.kt   | 10 +++++--
 .../ui/screen/nowplaying/NowPlayingScreen.kt  | 28 +++++++++++--------
 .../ui/theme/background/CustomBackground.kt   |  7 ++++-
 3 files changed, 31 insertions(+), 14 deletions(-)

diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt b/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt
index 709c0029..d894ddfc 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/component/lyrics/SyncedLyricsView.kt
@@ -23,6 +23,7 @@ package moe.ouom.neriplayer.ui.component.lyrics
  * Created: 2025/8/13
  */
 
+import moe.ouom.neriplayer.ui.tv.TvPerf
 import moe.ouom.neriplayer.data.model.lyrics.LyricEntry
 import moe.ouom.neriplayer.data.model.lyrics.WordTiming
 import moe.ouom.neriplayer.lyrics.parser.calculateLineProgress
@@ -696,7 +697,11 @@ fun SyncedLyricsView(
         val requestTarget = autoScrollTarget
         isAutoScrolling = true
         try {
-            listState.animateScrollToItem(currentIndex)
+            if (TvPerf.reduceMotion) {
+                listState.scrollToItem(currentIndex)
+            } else {
+                listState.animateScrollToItem(currentIndex)
+            }
         } finally {
             if (shouldFinishLyricAutoScroll(requestTarget, latestAutoScrollTarget)) {
                 isAutoScrolling = false
@@ -848,7 +853,8 @@ fun SyncedLyricsView(
                     )
 
                     val playbackBlurRadiusPx =
-                        if (isActive || !lyricBlurEnabled || !visualEffectsEnabled) {
+                        // 电视：关掉逐行模糊。每一行都要单独的 BlurEffect/阴影，滚动时等于每帧几十次模糊。
+                        if (isActive || !lyricBlurEnabled || !visualEffectsEnabled || TvPerf.disableBlur) {
                             0f
                         } else {
                             blurForDistance(distance, lyricBlurAmount)
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/screen/nowplaying/NowPlayingScreen.kt b/app/src/main/java/moe/ouom/neriplayer/ui/screen/nowplaying/NowPlayingScreen.kt
index 6d6ea925..d66f24b4 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/screen/nowplaying/NowPlayingScreen.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/screen/nowplaying/NowPlayingScreen.kt
@@ -23,6 +23,7 @@ package moe.ouom.neriplayer.ui.screen.nowplaying
  * Updated: 2026/3/23
  */
 
+import moe.ouom.neriplayer.ui.tv.TvPerf
 import moe.ouom.neriplayer.ui.haptic.performHapticFeedback
 import moe.ouom.neriplayer.data.identity.sameIdentityAs
 import moe.ouom.neriplayer.data.identity.stableKey
@@ -1190,17 +1191,22 @@ fun NowPlayingScreen(
                 Box(modifier = Modifier.fillMaxSize()) {
                     lyricsTransition.AnimatedContent(
                         transitionSpec = {
-                            (fadeIn(
-                                animationSpec = tween(
-                                    durationMillis = LyricsPageTransitionDurationMs,
-                                    easing = LinearEasing
-                                )
-                            ) togetherWith fadeOut(
-                                animationSpec = tween(
-                                    durationMillis = LyricsPageTransitionDurationMs,
-                                    easing = LinearEasing
-                                )
-                            )).using(nowPlayingLyricsSizeTransform(lyricsPredictiveBackPreviewActive))
+                            // 电视：封面飞行 + 整页尺寸变换是最贵的一段动画，直接瞬切
+                            if (TvPerf.reduceMotion) {
+                                EnterTransition.None togetherWith ExitTransition.None
+                            } else {
+                                (fadeIn(
+                                    animationSpec = tween(
+                                        durationMillis = LyricsPageTransitionDurationMs,
+                                        easing = LinearEasing
+                                    )
+                                ) togetherWith fadeOut(
+                                    animationSpec = tween(
+                                        durationMillis = LyricsPageTransitionDurationMs,
+                                        easing = LinearEasing
+                                    )
+                                )).using(nowPlayingLyricsSizeTransform(lyricsPredictiveBackPreviewActive))
+                            }
                         }
                     ) { isLyricsMode ->
                         if (shouldUseStandaloneNowPlayingLyricsPage(isLyricsMode, standaloneLyricsOnlyInPortrait)) {
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/theme/background/CustomBackground.kt b/app/src/main/java/moe/ouom/neriplayer/ui/theme/background/CustomBackground.kt
index 3f9932cd..d492eebc 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/theme/background/CustomBackground.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/theme/background/CustomBackground.kt
@@ -47,6 +47,7 @@ import androidx.compose.ui.unit.dp
 import androidx.core.net.toUri
 import coil.compose.AsyncImage
 import coil.request.CachePolicy
+import moe.ouom.neriplayer.ui.tv.TvPerf
 import moe.ouom.neriplayer.common.R as CoreCommonR
 import coil.request.ImageRequest
 import coil.size.Size
@@ -99,7 +100,10 @@ fun CustomBackground(
                 modifier = Modifier
                     .fillMaxSize()
                     .let { base ->
-                        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && blur > 0f) {
+                        // 电视上不模糊背景图：整屏 RenderEffect 是最贵的一档
+                        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && blur > 0f &&
+                            !TvPerf.disableBlur
+                        ) {
                             base.blur(blur.dp)
                         } else {
                             base
@@ -181,4 +185,5 @@ class BlurTransformation(
             rs?.destroy()
         }
     }
+
 }
