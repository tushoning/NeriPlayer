tag 名里的 yyyyMMdd-HHmm 会被 AppUpdateRepository 解析成 yyMMddHH，
再和 BuildConfig.VERSION_CODE 比大小。此前 tag 用 `date -u` 取发布时刻、
versionCode 用 JVM 默认时区取构建时刻，构建跨整点就差 1，
于是装上新包后应用内永远提示「有新版本」。

- CI 编译前生成一个 UTC 时间戳，同时喂给 -PbuildTimestamp 和 tag 名
- Common.getBuildVersionCode 固定 UTC，与本机时区无关
- sync-upstream.sh：checkout 到上游前先把 patches/ 备份到 build/sync-backup，
  否则被跟踪的 patches/ 会随 checkout 消失，git am 必然找不到补丁
---
 .github/workflows/fork-sync.yml               | 21 ++++++++++++---
 .../convention/src/main/kotlin/Common.kt      |  9 +++++--
 fork-tools/sync-upstream.sh                   | 26 +++++++++++++++++--
 3 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/.github/workflows/fork-sync.yml b/.github/workflows/fork-sync.yml
index 75960e68..b59dca67 100644
--- a/.github/workflows/fork-sync.yml
+++ b/.github/workflows/fork-sync.yml
@@ -209,6 +209,7 @@ jobs:
           echo "密钥库指纹校验通过：$GOT"
 
       - name: 编译电视包
+        id: build
         if: steps.apply.outputs.ok == 'true'
         env:
           ORG_GRADLE_PROJECT_KEYSTORE_FILE: aerial.keystore
@@ -217,7 +218,15 @@ jobs:
           ORG_GRADLE_PROJECT_KEY_PASSWORD: ${{ secrets.AERIAL_KEY_PASSWORD }}
         run: |
           set -euo pipefail
-          ./gradlew :app:assembleTvrelease --warning-mode all --stacktrace
+          # versionCode 和 tag 必须来自同一时刻。tag 名里的 yyyyMMdd-HHmm 会被
+          # AppUpdateRepository 解析成 yyMMddHH，再和 BuildConfig.VERSION_CODE 比大小；
+          # 以前 tag 取「发布时刻」、versionCode 取「构建时刻」，构建跨整点就差 1，
+          # 于是装上新包之后应用内仍然一直提示「有新版本」。
+          BUILD_TS=$(date -u +%s%3N)
+          BUILD_STAMP=$(date -u -d "@$((BUILD_TS / 1000))" +%Y%m%d-%H%M)
+          echo "stamp=$BUILD_STAMP" >> "$GITHUB_OUTPUT"
+          echo "构建时刻(UTC) $BUILD_STAMP"
+          ./gradlew :app:assembleTvrelease -PbuildTimestamp="$BUILD_TS" --warning-mode all --stacktrace
 
       - name: 删掉临时密钥
         if: always()
@@ -229,14 +238,20 @@ jobs:
         env:
           UPSTREAM_SHA: ${{ steps.up.outputs.new }}
           UPSTREAM_RELEASE: ${{ steps.up.outputs.release_tag }}
+          BUILD_STAMP: ${{ steps.build.outputs.stamp }}
         run: |
           set -euo pipefail
           APK=$(ls app/build/outputs/apk/tvrelease/*.apk | head -1)
           test -n "$APK" || { echo "::error::没找到 tvrelease 的 APK"; exit 1; }
           cp "$APK" "$APK_OUT"
           VERSION=$(basename "$APK" | sed 's/^NeriPlayer-//; s/-armeabi-v7a.*//; s/\.apk$//')
-          # tag 带月日时分，手动重复触发也不会撞车（同一个 tag 只能对应一次构建）
-          TAG="tv-$(date -u +%Y%m%d-%H%M)"
+          # tag 用编译步骤定下的那个时刻，保证 versionCodeOfTag(tag) == BuildConfig.VERSION_CODE。
+          # 兜底：万一 build 步骤没输出（理论上不会），退回当前时间。
+          if [ -n "${BUILD_STAMP:-}" ]; then
+            TAG="tv-${BUILD_STAMP}"
+          else
+            TAG="tv-$(date -u +%Y%m%d-%H%M)"
+          fi
           SRC_OUT="NeriPlayer-TV-${TAG}-source.tar.gz"
           REL_NOTE=""
           if [ -n "${UPSTREAM_RELEASE:-}" ]; then
diff --git a/build-logic/convention/src/main/kotlin/Common.kt b/build-logic/convention/src/main/kotlin/Common.kt
index 2c2e68ea..fb1df8c3 100644
--- a/build-logic/convention/src/main/kotlin/Common.kt
+++ b/build-logic/convention/src/main/kotlin/Common.kt
@@ -12,8 +12,13 @@ object Common {
             Date(timestamp)
         } ?: Date()
         val appVerCode: Int by lazy {
-            val versionCode = SimpleDateFormat("yyMMddHH", Locale.ENGLISH).format(buildDate)
-            versionCode.toInt()
+            // 必须固定 UTC：CI 的 tag 名用 `date -u +%Y%m%d-%H%M` 生成，
+            // AppUpdateRepository 再从 tag 里取 `yyMMddHH` 和 BuildConfig.VERSION_CODE 比大小。
+            // 两边时区不一致时（runner 是 UTC、本地是 UTC+8），tag 解析值会和安装包的版本号
+            // 差 8 小时，更新检查就会永远提示「有新版本」。
+            val sdf = SimpleDateFormat("yyMMddHH", Locale.ENGLISH)
+            sdf.timeZone = TimeZone.getTimeZone("UTC")
+            sdf.format(buildDate).toInt()
         }
         return appVerCode
     }
diff --git a/fork-tools/sync-upstream.sh b/fork-tools/sync-upstream.sh
index bed4bf2e..0093058d 100644
--- a/fork-tools/sync-upstream.sh
+++ b/fork-tools/sync-upstream.sh
@@ -58,20 +58,40 @@ if git merge-base --is-ancestor "$NEW_UPSTREAM" "$OLD_BASE"; then
 fi
 
 BRANCH="sync/$(date +%Y%m%d-%H%M)"
+
+# patches/ 是被 git 跟踪的，checkout 到上游提交后整个目录会消失，
+# 后面 `git am patches/series/*.patch` 就会报 "could not open ... No such file"。
+# 所以先把要用的补丁复制到仓库外（build/ 在 .gitignore 里，不会被提交）。
+BACKUP="$REPO_ROOT/build/sync-backup"
+rm -rf "$BACKUP"
+mkdir -p "$BACKUP"
+cp -a patches/tv-fork.diff "$BACKUP/tv-fork.diff"
+cp -a patches/series "$BACKUP/series"
+if [ -d patches/submodule ]; then
+  cp -a patches/submodule "$BACKUP/submodule"
+fi
+echo "补丁已备份到 $BACKUP"
+
 git checkout -B "$BRANCH" "$NEW_UPSTREAM"
 
 echo
 echo "== 应用我方改动（$MODE）=="
 set +e
 if [ "$MODE" = squash ]; then
-  git apply -3 patches/tv-fork.diff
+  git apply -3 "$BACKUP/tv-fork.diff"
   RC=$?
 else
-  git am -3 --keep-cr patches/series/*.patch
+  git am -3 --keep-cr "$BACKUP"/series/*.patch
   RC=$?
 fi
 set -e
 
+# 子模块补丁是手写的、不属于任何补丁，得手动搬回来（make-patches.sh 会原样保留）
+mkdir -p patches
+if [ -d "$BACKUP/submodule" ]; then
+  cp -a "$BACKUP/submodule" patches/submodule
+fi
+
 if [ "$RC" -ne 0 ]; then
   cat <<'EOF'
 
@@ -120,3 +140,5 @@ echo
 echo "下一步："
 echo "  bash fork-tools/make-patches.sh        # 把基线更新成新上游"
 echo "  git checkout main && git reset --hard $BRANCH && git push -f origin main"
+echo
+echo "补丁来源备份在 build/sync-backup，确认无误后可以删。"
