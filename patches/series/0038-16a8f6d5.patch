         uses: actions/checkout@v4
         with:
+          # 必须用 PAT（secret SYNC_TOKEN），不能用默认 GITHUB_TOKEN。
+          # GITHUB_TOKEN 在设计上就拿不到 workflows 权限，推到 .github/workflows/ 的提交会被拒：
+          #   ! [remote rejected] (refusing to allow a GitHub App to create or update workflow
+          #    `.github/workflows/xxx.yml` without `workflows` permission)
+          # 而我们的补丁必然会改 .github/workflows/fork-sync.yml，所以每次 rebase 都推不上去。
+          # 注意：token 必须给 checkout，不能只给后面的 push —— checkout 会把凭据写进 git config，
+          # 后续所有 git 命令都用它，单独给 push 设 token 是无效的。
+          token: ${{ secrets.SYNC_TOKEN || secrets.GITHUB_TOKEN }}
           fetch-depth: 0 # 需要完整历史：git am -3 要用到补丁的原始 blob
           submodules: recursive
 
