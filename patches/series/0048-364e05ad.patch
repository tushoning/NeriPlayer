-    private fun AppUpdateRepository.Latest?.toUiState(): UpdateCheckUiState = when {
-        this == null -> UpdateCheckUiState.Failed
-        versionCode <= BuildConfig.VERSION_CODE -> UpdateCheckUiState.UpToDate
