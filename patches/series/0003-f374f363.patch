+import moe.ouom.neriplayer.ui.tv.TvPerf
 import moe.ouom.neriplayer.ui.tv.rememberTvFocusRingIndication
 import androidx.compose.foundation.interaction.MutableInteractionSource
 import androidx.compose.foundation.LocalIndication
@@ -1202,6 +1203,11 @@ fun PlayingIndicator(
     color: Color = MaterialTheme.colorScheme.primary,
     animate: Boolean = true
 ) {
+    // 电视：不创建无限动画。只要还读着动画 state，这一行就永远在重绘，列表滚动时尤其浪费。
+    if (TvPerf.reduceMotion) {
+        StaticPlayingIndicator(modifier = modifier, color = color)
+        return
+    }
     val transition = rememberInfiniteTransition(label = "playing")
     val flatHeight = 0.35f
     val transitionSpec: FiniteAnimationSpec<Float> =
@@ -1275,3 +1281,23 @@ fun PlayingIndicator(
 
 private fun playingBarHoldTarget(animate: Boolean, animated: State<Float>, flatHeight: Float): Float =
     if (animate) animated.value else flatHeight
+
+/** 电视用的静态「播放中」指示：固定高度，不读任何动画 state。 */
+@Composable
+private fun StaticPlayingIndicator(modifier: Modifier = Modifier, color: Color) {
+    Row(
+        modifier = modifier.height(12.dp),
+        verticalAlignment = Alignment.Bottom,
+        horizontalArrangement = Arrangement.spacedBy(1.dp)
+    ) {
+        listOf(0.45f, 0.7f, 0.55f).forEach { fraction ->
+            Box(
+                Modifier
+                    .width(3.dp)
+                    .height(12.dp * fraction)
+                    .clip(RoundedCornerShape(50))
+                    .background(color)
+            )
+        }
+    }
+}
diff --git a/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt b/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt
index 608f583c..649c8650 100644
--- a/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/ui/theme/NeriTheme.kt
@@ -161,7 +161,11 @@ fun NeriTheme(
                 TvFocusIndication(tvRingColor, cornerRadius = tvRingRadius)
             }
             // 电视上关掉所有装饰性动效（标签切换、页面进出场），只保留播放页动画
-            SideEffect { TvPerf.reduceMotion = isTelevision }
+            // 玻璃模糊同样关掉：RenderEffect 在电视 GPU 上每帧都要重新取样，是最大的一个开销
+            SideEffect {
+                TvPerf.reduceMotion = isTelevision
+                TvPerf.disableBlur = isTelevision
+            }
             // Material3 的组件（Surface/Card/Button/列表项）内部硬写 ripple()，不读 LocalIndication，
             // 所以额外把 ripple 的焦点态叠加强化，否则电视上看不出光标停在哪
             val tvRipple = remember(colorScheme.primary) {
