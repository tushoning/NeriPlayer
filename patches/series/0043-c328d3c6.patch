+/** 分页横条里每张卡的 FocusRequester 登记表（按 item index） */
+internal class TvPagerFocus {
+    private val requesters = HashMap<Int, FocusRequester>()
+    fun requester(index: Int): FocusRequester =
+        requesters.getOrPut(index) { FocusRequester() }
+}
