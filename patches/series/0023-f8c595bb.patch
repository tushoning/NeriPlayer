+          # 密钥传错的话，包发出去也装不上（签名不一致），这里先验一遍。
+          # 指纹是公开信息（不是秘密），直接写死，省得再配一个 secret。
+          GOT=$(keytool -list -v -keystore app/aerial.keystore -storepass "$STORE_PASS" \
+                  -alias "$KEY_ALIAS" 2>/dev/null \
+                | sed -n 's/^[[:space:]]*SHA256: //p' | tr -d ':' | tr 'A-Z' 'a-z')
+          WANT=$(printf '%s' "$CERT_SHA256" | tr -d ':' | tr 'A-Z' 'a-z')
+          if [ "$GOT" != "$WANT" ]; then
+            echo "::error::密钥库证书指纹不符，期望 $WANT 实际 $GOT"
+            exit 1
           fi
+          echo "密钥库指纹校验通过：$GOT"
 
       - name: 编译电视包
