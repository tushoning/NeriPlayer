@@ -214,6 +212,22 @@ jobs:
           本构建不是上游官方发布，也不代表上游作者的观点。
           EOF
 
+      - name: 校验产物的签名
+        if: steps.apply.outputs.ok == 'true'
+        run: |
+          set -euo pipefail
+          SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-/usr/local/lib/android/sdk}}"
+          BT=$(ls -d "$SDK"/build-tools/*/ | sort -V | tail -1)
+          GOT=$("${BT}apksigner" verify --print-certs "$APK_OUT" \
+                | grep -i 'SHA-256 digest' | head -1 | sed 's/.*digest: *//' \
+                | tr -d ':' | tr 'A-Z' 'a-z')
+          WANT=$(printf '%s' "$CERT_SHA256" | tr -d ':' | tr 'A-Z' 'a-z')
+          if [ "$GOT" != "$WANT" ]; then
+            echo "::error::APK 签名指纹不符：期望 $WANT 实际 $GOT（签名没生效？）"
+            exit 1
+          fi
+          echo "APK 签名校验通过：$GOT"
+
       - name: 打 tag 并发布 Release
         if: steps.apply.outputs.ok == 'true'
         env:
