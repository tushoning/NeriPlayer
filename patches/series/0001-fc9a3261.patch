+private const val ENCYCLOPEDIA_ARTIST_BRIEF_MAX_LINES = 4
+private const val ENCYCLOPEDIA_ARTIST_AVATAR_SIZE_DP = 48
+private val ENCYCLOPEDIA_ARTIST_TEXT_FOLLOW_MIN_WIDTH = 320.dp
+/**
+ * 模块五 关于艺人。
+ *
+ * 粉丝数无匿名数据源，本页**不展示**；
+ * 关注按钮仅在网易云登录后出现（见 [SongEncyclopediaArtistFollowButton]）。
+ */
+@Composable
+internal fun SongEncyclopediaArtistSection(
+    artist: EncyclopediaArtistInfo,
+    onOpenArtist: () -> Unit
+) {
+    SongEncyclopediaSectionCard(
+        titleRes = AppR.string.encyclopedia_section_artist,
+        icon = Icons.Outlined.Person
+    ) {
+        BoxWithConstraints(modifier = Modifier.fillMaxWidth()) {
+            // 按文字缩放后的可用宽度收起按钮标签，给窄屏的姓名和数量留出空间
+            val compactFollow = maxWidth / LocalDensity.current.fontScale < ENCYCLOPEDIA_ARTIST_TEXT_FOLLOW_MIN_WIDTH
+            Row(
+                modifier = Modifier.fillMaxWidth().padding(vertical = 8.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                SongEncyclopediaArtistAvatar(artist, Modifier.encyclopediaClickable(onOpenArtist))
+                Spacer(Modifier.size(12.dp))
+                // 电视：这一列（姓名 + 作品数）和左边的头像是同一个跳转入口，
+                // 遥控器上没必要多停一站，焦点只留在头像上。
+                val tvNoFocus = if (LocalIsTelevision.current) {
+                    Modifier.focusProperties { canFocus = false }
+                } else {
+                    Modifier
+                }
+                Column(
+                    modifier = Modifier.weight(1f).then(tvNoFocus).encyclopediaClickable(onOpenArtist),
+                    verticalArrangement = Arrangement.spacedBy(2.dp)
+                ) {
+                    Text(
+                        text = artist.name,
+                        style = MaterialTheme.typography.titleMedium,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis
+                    )
+                    val meta = buildEncyclopediaArtistMeta(artist)
+                    if (meta != null) {
+                        Text(
+                            text = meta,
+                            modifier = Modifier.fillMaxWidth(),
+                            style = MaterialTheme.typography.labelMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant
+                        )
+                    }
+                }
+                SongEncyclopediaArtistFollowButton(artist, Modifier.padding(start = 8.dp), compact = compactFollow)
+            }
+        }
+        SongEncyclopediaArtistBrief(artist)
+    }
+}
+@Composable
+private fun SongEncyclopediaArtistAvatar(artist: EncyclopediaArtistInfo, modifier: Modifier = Modifier) {
+    val size = ENCYCLOPEDIA_ARTIST_AVATAR_SIZE_DP.dp
+    val url = artist.picUrl
+    if (url.isNullOrBlank()) {
+        Box(
+            modifier = modifier
+                .size(size)
+                .clip(CircleShape)
+                .background(MaterialTheme.colorScheme.surfaceContainerHighest)
+        )
+        return
+    }
+    AsyncImage(
+        model = url,
+        contentDescription = null,
+        contentScale = ContentScale.Crop,
+        modifier = modifier
+            .size(size)
+            .clip(CircleShape)
+            .background(MaterialTheme.colorScheme.surfaceContainerHighest)
+    )
+}
+@Composable
+internal fun SongEncyclopediaArtistBrief(artist: EncyclopediaArtistInfo) {
+    val brief = artist.briefDesc?.takeIf { it.isNotBlank() }
+    if (brief == null) {
+        SongEncyclopediaEmptyHint(AppR.string.encyclopedia_empty)
+        return
+    }
+    var expanded by rememberSaveable(artist.artistId, brief) { mutableStateOf(false) }
+    var canExpand by remember(artist.artistId, brief) { mutableStateOf(false) }
+    Text(
+        text = brief,
+        style = MaterialTheme.typography.bodySmall,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+        maxLines = if (expanded) Int.MAX_VALUE else ENCYCLOPEDIA_ARTIST_BRIEF_MAX_LINES,
+        overflow = TextOverflow.Ellipsis,
+        onTextLayout = { layout ->
+            // 展开后按实际行数保留收起入口，宽度或字号变化后也重新判断
+            canExpand = layout.hasVisualOverflow || layout.lineCount > ENCYCLOPEDIA_ARTIST_BRIEF_MAX_LINES
+        },
+        modifier = Modifier.fillMaxWidth()
+    )
+    if (canExpand) {
+        SongEncyclopediaActionSpacer()
+        SongEncyclopediaExpandAction(expanded = expanded, onToggle = { expanded = !expanded })
+    }
+}
+@Composable
+private fun buildEncyclopediaArtistMeta(artist: EncyclopediaArtistInfo): String? {
+    val albums = artist.albumSize ?: return null
+    val songs = artist.musicSize ?: return null
+    return stringResource(AppR.string.encyclopedia_artist_bio_note, albums, songs)
 }
