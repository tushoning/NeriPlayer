+ * Created: 2026/10/26
+ */
+
+/**
+ * 电视端的性能开关。
+ *
+ * 电视盒子/电视机的 SoC 比手机弱得多，Compose 的转场动画、位图模糊、玻璃取样
+ * 都是纯装饰，却要吃掉大量 GPU/CPU。这些开关由主题层在电视上统一打开，
+ * 播放页的动画不受影响。
+ */
+object TvPerf {
+
+    /** 关掉页面转场、标签切换、预测性返回预览等装饰性动效 */
+    @Volatile
+    var reduceMotion: Boolean = false
+
+    /** 关掉玻璃模糊取样 */
+    @Volatile
+    var disableBlur: Boolean = false
+}
