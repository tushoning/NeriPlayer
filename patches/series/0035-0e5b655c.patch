+      - name: 检查上游有没有新 Release
         id: up
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           set -euo pipefail
+
+          # ---------- 1. 上游最新的正式 Release（忽略草稿和预发布）----------
+          # 「已处理过」靠 tag 记：seen/<上游 Release 名>，构建全流程跑完后才打。
+          REL_TAG=$(curl -fsSL \
+            -H "Accept: application/vnd.github+json" \
+            -H "Authorization: Bearer $GH_TOKEN" \
+            "$UPSTREAM_API/releases?per_page=30" \
+            | python3 -c 'import json,sys; rs=json.load(sys.stdin); print(next((r["tag_name"] for r in rs if not r.get("draft") and not r.get("prerelease")), ""))') \
+            || { echo "::error::读取上游 Release 列表失败"; exit 1; }
+          echo "release_tag=$REL_TAG" >> "$GITHUB_OUTPUT"
+
+          # tag 可能没被 checkout 拉全（fetch-depth: 0 通常够，这里再兜一次）
+          git fetch --quiet origin '+refs/tags/seen/*:refs/tags/seen/*' 2>/dev/null || true
+
+          SEEN=false
+          if [ -n "$REL_TAG" ] && git rev-parse -q --verify "refs/tags/seen/$REL_TAG" >/dev/null; then
+            SEEN=true
+          fi
+
+          # ---------- 2. 上游 master 有没有我们基线之后的新提交 ----------
           git remote add upstream "$UPSTREAM_REPO" 2>/dev/null || git remote set-url upstream "$UPSTREAM_REPO"
           git fetch --quiet upstream master
           NEW=$(git rev-parse upstream/master)
           BASE=$(sed -n 's/^base_full_sha=//p' patches/BASE)
-          echo "new=$NEW" >> "$GITHUB_OUTPUT"
-          echo "base=$BASE" >> "$GITHUB_OUTPUT"
           if [ -z "$BASE" ]; then
             echo "::error::patches/BASE 里读不到 base_full_sha"
             exit 1
           fi
           if git merge-base --is-ancestor "$NEW" "$BASE"; then
-            echo "changed=false" >> "$GITHUB_OUTPUT"
-            echo "上游没有新提交（当前基线 $(git rev-parse --short "$BASE")）。"
-            if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
-              echo "build=true" >> "$GITHUB_OUTPUT"
-              echo "→ 手动触发，仍然用当前代码编译出包。"
-            else
-              echo "build=false" >> "$GITHUB_OUTPUT"
-              echo "→ 定时触发，跳过（不编译）。"
-            fi
+            CHANGED=false
           else
-            echo "changed=true" >> "$GITHUB_OUTPUT"
+            CHANGED=true
+          fi
+
+          echo "new=$NEW" >> "$GITHUB_OUTPUT"
+          echo "base=$BASE" >> "$GITHUB_OUTPUT"
+          echo "changed=$CHANGED" >> "$GITHUB_OUTPUT"
+
+          # ---------- 3. 结论 ----------
+          if [ -z "$REL_TAG" ]; then
+            echo "上游还没有正式 Release。"
+            REL_NEW=false
+          elif [ "$SEEN" = "true" ]; then
+            echo "上游最新 Release 已处理过：$REL_TAG"
+            REL_NEW=false
