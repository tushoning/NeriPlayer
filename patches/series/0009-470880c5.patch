+    paneWidth: Dp,
+    coverIdentitySpacing: Dp,
+    identitySlotHeight: Dp,
+    groupGap: Dp,
+    coverMaxSide: Dp,
+    modifier: Modifier = Modifier,
+    topBar: @Composable () -> Unit,
+    cover: @Composable (Modifier) -> Unit,
