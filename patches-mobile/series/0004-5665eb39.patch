- 三条链路统一成「直连 + gh-proxy + ghfast」，探测、API、下载都走这三条
- 日常只发一次 /releases/latest 重定向 + 一次 HEAD，不消耗 API 配额
- 只有资产不存在或重定向全挂时才查 Releases API，按资产名往前找
- 与电视版共用同一份实现，仅资产名不同
---
 .../neriplayer/update/AppUpdateRepository.kt  | 134 +++++++++++++-----
 1 file changed, 97 insertions(+), 37 deletions(-)

diff --git a/app/src/main/java/moe/ouom/neriplayer/update/AppUpdateRepository.kt b/app/src/main/java/moe/ouom/neriplayer/update/AppUpdateRepository.kt
index 86105a52..a44b5d34 100644
--- a/app/src/main/java/moe/ouom/neriplayer/update/AppUpdateRepository.kt
+++ b/app/src/main/java/moe/ouom/neriplayer/update/AppUpdateRepository.kt
@@ -1,5 +1,5 @@
 /*
- * NeriPlayer - update channel (mobile build).
+ * NeriPlayer - update channel.
  *
  * This file is part of NeriPlayer (GPL-3.0-or-later).
  */
@@ -18,15 +18,16 @@ import java.net.URL
 /**
  * 更新通道：只认我们自己 fork 仓库的 Release。
  *
- * 电视版和手机版走**同一个 Release**（CI 一次出两个包），各取各的资产：
- * - 电视版：`NeriPlayer-tv-arm32-v7a.apk`
- * - 手机版：`NeriPlayer-Mobile-arm64-v8a.apk`
+ * 电视版和手机版共用这一套，唯一差别是 [ASSET_NAME]（两个包挂在同一个 Release 里）。
  *
- * 所以这里不能只看 tag 前缀，而是按「最新一个附带手机包的 Release」来挑 ——
- * 只挂电视包的 Release 会被自动跳过，绝不会把电视包当手机版的更新推下来。
+ * 探测分两步，日常只走第一步：
+ * 1. 请求 `/releases/latest`，从 302 的 `Location` 里取 tag（不花 API 配额），
+ *    再对自己那个资产发一次 HEAD，确认这个 Release 里确实有我们的包；
+ * 2. 资产不存在（比如手动发过只带另一种包的 Release）或者第一步整个走不通，
+ *    才退到 Releases API，按资产名在历史 Release 里往前找。
  *
- * 版本比较不解析 `versionName`，而是拿 Release tag 里的时间对 `versionCode` ——
- * 构建脚本就是按 `yyMMddHH` 生成的（见 `build-logic/convention/Common.kt`）。
+ * 三条链路统一：直连 + gh-proxy + ghfast。下载时先各发一个 1KB 请求测延迟再挑，
+ * 失败自动换下一条。
  */
 internal object AppUpdateRepository {
 
@@ -35,15 +36,8 @@ internal object AppUpdateRepository {
     /** 手机包资产名，和 CI 出包保持一致 */
     private const val ASSET_NAME = "NeriPlayer-Mobile-arm64-v8a.apk"
 
-    /** 前两条是国内加速镜像，最后一条是原链接；下载时按实测延迟排序后再挑。 */
-    private val downloadBases = listOf(
-        "https://gh-proxy.com/",
-        "https://ghfast.top/",
-        ""
-    )
-
-    /** Release 列表只能走 API；镜像同样套在前面。 */
-    private val apiBases = listOf(
+    /** 一条直连 + 两条国内加速，三个入口对所有请求通用 */
+    private val BASES = listOf(
         "",
         "https://gh-proxy.com/",
         "https://ghfast.top/"
@@ -54,9 +48,8 @@ internal object AppUpdateRepository {
     /**
      * 一次检查的结果。
      *
-     * 必须把「接口通了、但仓库里没有手机版 Release」和「网络/接口挂了」分开：
-     * 前者是正常状态（还没发过手机包），界面应该显示「暂无新版本」，
-     * 不能每开机一次就弹「检查更新失败」。
+     * 必须把「接口通了、但仓库里没有我的包」和「网络/接口挂了」分开：
+     * 前者是正常状态，界面应该显示「暂无新版本」，不能每次开机都弹「检查更新失败」。
      */
     sealed interface FetchResult {
         data class Found(val latest: Latest) : FetchResult
@@ -65,11 +58,28 @@ internal object AppUpdateRepository {
     }
 
     suspend fun fetchLatest(): FetchResult = withContext(Dispatchers.IO) {
-        for (base in apiBases) {
-            val scan = runCatching { scanReleases("${base}${apiUrl()}") }
+        // ---------- 第一步：latest 重定向 + 资产 HEAD ----------
+        for (base in BASES) {
+            val tag = runCatching { resolveLatestTag(base) }.getOrNull() ?: continue
+            val code = versionCodeOfTag(tag)
+            if (code <= 0) continue
+            // 资产在就直接用；不在说明这个 Release 没带我们的包，交给 API 往前找
+            if (assetExists(tag)) {
+                return@withContext FetchResult.Found(Latest(tag, code))
+            }
+            break
+        }
+
+        // ---------- 第二步：Releases API 兜底 ----------
+        for (base in BASES) {
+            val scan = runCatching { scanReleases(base + apiUrl()) }
             if (scan.isSuccess) {
                 val latest = scan.getOrNull()
-                return@withContext if (latest != null) FetchResult.Found(latest) else FetchResult.NotFound
+                return@withContext if (latest != null) {
+                    FetchResult.Found(latest)
+                } else {
+                    FetchResult.NotFound
+                }
             }
         }
         FetchResult.Failed
@@ -79,10 +89,60 @@ internal object AppUpdateRepository {
         "https://api.github.com/repos/$REPO/releases?per_page=50"
 
     /**
-     * 拉一页 Release，挑出「附带手机包」的那条（非草稿、非预发布），取 versionCode 最大的。
+     * `/releases/latest` 会 302 到 `/releases/tag/<tag>`，tag 直接从 Location 里取。
+     *
+     * 注意 gh-proxy 会自己跟到底并返回 HTML，拿不到 Location —— 它在这一步会自然失败，
+     * 由后面的入口接手；真正需要它的是下载和 API。
+     */
+    private fun resolveLatestTag(base: String): String? {
+        val url = "${base}https://github.com/$REPO/releases/latest"
+        val conn = (URL(url).openConnection() as HttpURLConnection).apply {
+            instanceFollowRedirects = false
+            connectTimeout = TIMEOUT_CONNECT
+            readTimeout = TIMEOUT_READ
+            requestMethod = "GET"
+        }
+        return try {
+            val location = conn.getHeaderField("Location") ?: return null
+            location.substringAfterLast("/releases/tag/", "").trim().ifBlank { null }
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    /**
+     * 这个 Release 里有没有我们那个资产。
      *
-     * 一次 CI 会同时传电视包和手机包，所以直接按资产名认，tag 是什么前缀都不影响；
-     * 只挂电视包的 Release 会被跳过。
+     * 只认直连和 ghfast（gh-proxy 不保证支持 HEAD）。探测不出来时按「存在」处理，
+     * 免得把一次网络抖动当成「没有包」而白跑一遍 API。
+     */
+    private fun assetExists(tag: String): Boolean {
+        for (base in listOf("", "https://ghfast.top/")) {
+            val code = runCatching { headCode(assetUrl(base, tag)) }.getOrNull() ?: continue
+            if (code in 200..299) return true
+            if (code == 404) return false
+        }
+        return true
+    }
+
+    private fun headCode(url: String): Int {
+        val conn = (URL(url).openConnection() as HttpURLConnection).apply {
+            connectTimeout = TIMEOUT_CONNECT
+            readTimeout = TIMEOUT_READ
+            requestMethod = "HEAD"
+            instanceFollowRedirects = true
+        }
+        return try {
+            conn.responseCode
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    /**
+     * 拉一页 Release，挑出「附带我们这个资产」的那条（非草稿、非预发布），取 versionCode 最大的。
+     *
+     * tag 是什么前缀都不影响；只挂另一种包的 Release 会被跳过。
      */
     private fun scanReleases(url: String): Latest? {
         val body = httpGet(url) ?: throw IllegalStateException("release api unavailable")
@@ -91,7 +151,7 @@ internal object AppUpdateRepository {
         for (index in 0 until array.length()) {
             val item = array.optJSONObject(index) ?: continue
             if (item.optBoolean("draft") || item.optBoolean("prerelease")) continue
-            if (!hasMobileAsset(item.optJSONArray("assets"))) continue
+            if (!hasOurAsset(item.optJSONArray("assets"))) continue
             val tag = item.optString("tag_name")
             val code = versionCodeOfTag(tag)
             if (code <= 0) continue
@@ -100,7 +160,7 @@ internal object AppUpdateRepository {
         return best
     }
 
-    private fun hasMobileAsset(assets: JSONArray?): Boolean {
+    private fun hasOurAsset(assets: JSONArray?): Boolean {
         if (assets == null) return false
         for (i in 0 until assets.length()) {
             val asset = assets.optJSONObject(i) ?: continue
@@ -116,7 +176,7 @@ internal object AppUpdateRepository {
             requestMethod = "GET"
             setRequestProperty("Accept", "application/vnd.github+json")
             // GitHub API 不带 UA 会直接 403
-            setRequestProperty("User-Agent", "NeriPlayer-Mobile")
+            setRequestProperty("User-Agent", "NeriPlayer")
         }
         return try {
             if (conn.responseCode !in 200..299) return null
@@ -126,13 +186,6 @@ internal object AppUpdateRepository {
         }
     }
 
-    /** `tv-20261119-0230` → `26111902`，与构建脚本的 `yyMMddHH` 对齐（只看 tag 里的时间，不看前缀）。 */
-    fun versionCodeOfTag(tag: String): Int {
-        val match = TAG_PATTERN.find(tag) ?: return 0
-        val (year, month, day, hour) = match.destructured
-        return (year.takeLast(2) + month + day + hour).toIntOrNull() ?: 0
-    }
-
     /**
      * 下载到 `cacheDir/app_update/<tag>.apk`。
      *
@@ -146,7 +199,7 @@ internal object AppUpdateRepository {
     ): File? = withContext(Dispatchers.IO) {
         val dir = File(context.cacheDir, UPDATE_DIR).apply { mkdirs() }
         val target = File(dir, "$tag.apk")
-        val ordered = downloadBases.sortedBy { latencyMillis(assetUrl(it, tag)) }
+        val ordered = BASES.sortedBy { latencyMillis(assetUrl(it, tag)) }
         for (base in ordered) {
             val ok = runCatching { fetchToFile(assetUrl(base, tag), target, onProgress) }
                 .getOrDefault(false)
@@ -230,4 +283,11 @@ internal object AppUpdateRepository {
     private const val TIMEOUT_READ = 12000
     private const val TIMEOUT_DOWNLOAD_READ = 30000
     private const val BUFFER_SIZE = 64 * 1024
+
+    /** `v-20261119-0345` / `tv-20261119-0345` → `26111903`，与构建脚本的 `yyMMddHH` 对齐。 */
+    fun versionCodeOfTag(tag: String): Int {
+        val match = TAG_PATTERN.find(tag) ?: return 0
+        val (year, month, day, hour) = match.destructured
+        return (year.takeLast(2) + month + day + hour).toIntOrNull() ?: 0
+    }
 }
