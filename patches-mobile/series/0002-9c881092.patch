@@ -0,0 +1,233 @@
+/*
+ * NeriPlayer - update channel (mobile build).
+ *
+ * This file is part of NeriPlayer (GPL-3.0-or-later).
+ */
+package moe.ouom.neriplayer.update
+
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.FileProvider
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * 更新通道：只认我们自己 fork 仓库的 Release。
+ *
+ * 电视版和手机版走**同一个 Release**（CI 一次出两个包），各取各的资产：
+ * - 电视版：`NeriPlayer-tv-arm32-v7a.apk`
+ * - 手机版：`NeriPlayer-Mobile-arm64-v8a.apk`
+ *
+ * 所以这里不能只看 tag 前缀，而是按「最新一个附带手机包的 Release」来挑 ——
+ * 只挂电视包的 Release 会被自动跳过，绝不会把电视包当手机版的更新推下来。
+ *
+ * 版本比较不解析 `versionName`，而是拿 Release tag 里的时间对 `versionCode` ——
+ * 构建脚本就是按 `yyMMddHH` 生成的（见 `build-logic/convention/Common.kt`）。
+ */
+internal object AppUpdateRepository {
+
+    private const val REPO = "tushoning/NeriPlayer"
+
+    /** 手机包资产名，和 CI 出包保持一致 */
+    private const val ASSET_NAME = "NeriPlayer-Mobile-arm64-v8a.apk"
+
+    /** 前两条是国内加速镜像，最后一条是原链接；下载时按实测延迟排序后再挑。 */
+    private val downloadBases = listOf(
+        "https://gh-proxy.com/",
+        "https://ghfast.top/",
+        ""
+    )
+
+    /** Release 列表只能走 API；镜像同样套在前面。 */
+    private val apiBases = listOf(
+        "",
+        "https://gh-proxy.com/",
+        "https://ghfast.top/"
+    )
+
+    data class Latest(val tag: String, val versionCode: Int)
+
+    /**
+     * 一次检查的结果。
+     *
+     * 必须把「接口通了、但仓库里没有手机版 Release」和「网络/接口挂了」分开：
+     * 前者是正常状态（还没发过手机包），界面应该显示「暂无新版本」，
+     * 不能每开机一次就弹「检查更新失败」。
+     */
+    sealed interface FetchResult {
+        data class Found(val latest: Latest) : FetchResult
+        data object NotFound : FetchResult
+        data object Failed : FetchResult
+    }
+
+    suspend fun fetchLatest(): FetchResult = withContext(Dispatchers.IO) {
+        for (base in apiBases) {
+            val scan = runCatching { scanReleases("${base}${apiUrl()}") }
+            if (scan.isSuccess) {
+                val latest = scan.getOrNull()
+                return@withContext if (latest != null) FetchResult.Found(latest) else FetchResult.NotFound
+            }
+        }
+        FetchResult.Failed
+    }
+
+    private fun apiUrl(): String =
+        "https://api.github.com/repos/$REPO/releases?per_page=50"
+
+    /**
+     * 拉一页 Release，挑出「附带手机包」的那条（非草稿、非预发布），取 versionCode 最大的。
+     *
+     * 一次 CI 会同时传电视包和手机包，所以直接按资产名认，tag 是什么前缀都不影响；
+     * 只挂电视包的 Release 会被跳过。
+     */
+    private fun scanReleases(url: String): Latest? {
+        val body = httpGet(url) ?: throw IllegalStateException("release api unavailable")
+        val array = JSONArray(body)
+        var best: Latest? = null
+        for (index in 0 until array.length()) {
+            val item = array.optJSONObject(index) ?: continue
+            if (item.optBoolean("draft") || item.optBoolean("prerelease")) continue
+            if (!hasMobileAsset(item.optJSONArray("assets"))) continue
+            val tag = item.optString("tag_name")
+            val code = versionCodeOfTag(tag)
+            if (code <= 0) continue
+            if (best == null || code > best.versionCode) best = Latest(tag, code)
+        }
+        return best
+    }
+
+    private fun hasMobileAsset(assets: JSONArray?): Boolean {
+        if (assets == null) return false
+        for (i in 0 until assets.length()) {
+            val asset = assets.optJSONObject(i) ?: continue
+            if (asset.optString("name") == ASSET_NAME) return true
+        }
+        return false
+    }
+
+    private fun httpGet(url: String): String? {
+        val conn = (URL(url).openConnection() as HttpURLConnection).apply {
+            connectTimeout = TIMEOUT_CONNECT
+            readTimeout = TIMEOUT_READ
+            requestMethod = "GET"
+            setRequestProperty("Accept", "application/vnd.github+json")
+            // GitHub API 不带 UA 会直接 403
+            setRequestProperty("User-Agent", "NeriPlayer-Mobile")
+        }
+        return try {
+            if (conn.responseCode !in 200..299) return null
+            conn.inputStream.bufferedReader().use { it.readText() }
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    /** `tv-20261119-0230` → `26111902`，与构建脚本的 `yyMMddHH` 对齐（只看 tag 里的时间，不看前缀）。 */
+    fun versionCodeOfTag(tag: String): Int {
+        val match = TAG_PATTERN.find(tag) ?: return 0
+        val (year, month, day, hour) = match.destructured
+        return (year.takeLast(2) + month + day + hour).toIntOrNull() ?: 0
+    }
+
+    /**
+     * 下载到 `cacheDir/app_update/<tag>.apk`。
+     *
+     * 三条链接先各发一个 1KB 的 Range 请求测延迟，按快慢依次尝试；一条失败自动换下一条。
+     * 返回 null 表示全部失败。
+     */
+    suspend fun download(
+        context: Context,
+        tag: String,
+        onProgress: (Int) -> Unit
+    ): File? = withContext(Dispatchers.IO) {
+        val dir = File(context.cacheDir, UPDATE_DIR).apply { mkdirs() }
+        val target = File(dir, "$tag.apk")
+        val ordered = downloadBases.sortedBy { latencyMillis(assetUrl(it, tag)) }
+        for (base in ordered) {
+            val ok = runCatching { fetchToFile(assetUrl(base, tag), target, onProgress) }
+                .getOrDefault(false)
+            if (ok && target.length() > 0L) return@withContext target
+        }
+        runCatching { target.delete() }
+        null
+    }
+
+    private fun assetUrl(base: String, tag: String): String =
+        "${base}https://github.com/$REPO/releases/download/$tag/$ASSET_NAME"
+
+    private fun latencyMillis(url: String): Long {
+        val startedAt = System.nanoTime()
+        return runCatching {
+            val conn = (URL(url).openConnection() as HttpURLConnection).apply {
+                connectTimeout = TIMEOUT_PROBE
+                readTimeout = TIMEOUT_PROBE
+                requestMethod = "GET"
+                setRequestProperty("Range", "bytes=0-1023")
+            }
+            try {
+                conn.inputStream.use { it.readBytes() }
+                (System.nanoTime() - startedAt) / 1_000_000L
+            } finally {
+                conn.disconnect()
+            }
+        }.getOrDefault(Long.MAX_VALUE)
+    }
+
+    private fun fetchToFile(url: String, target: File, onProgress: (Int) -> Unit): Boolean {
+        val conn = (URL(url).openConnection() as HttpURLConnection).apply {
+            connectTimeout = TIMEOUT_CONNECT
+            readTimeout = TIMEOUT_DOWNLOAD_READ
+        }
+        return try {
+            if (conn.responseCode !in 200..299) return false
+            val total = conn.contentLengthLong
+            conn.inputStream.use { input ->
+                target.outputStream().use { output ->
+                    val buffer = ByteArray(BUFFER_SIZE)
+                    var written = 0L
+                    while (true) {
+                        val read = input.read(buffer)
+                        if (read <= 0) break
+                        output.write(buffer, 0, read)
+                        written += read
+                        if (total > 0L) {
+                            onProgress(((written * 100) / total).toInt().coerceIn(0, 100))
+                        }
+                    }
+                }
+            }
+            onProgress(100)
+            true
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    /** 交给系统安装器。文件必须在 FileProvider 暴露的 `app_update/` 目录下。 */
+    fun install(context: Context, apk: File) {
+        val uri = FileProvider.getUriForFile(
+            context,
+            "${context.packageName}.fileprovider",
+            apk
+        )
+        val intent = Intent(Intent.ACTION_VIEW).apply {
+            setDataAndType(uri, "application/vnd.android.package-archive")
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        context.startActivity(intent)
+    }
+
+    const val UPDATE_DIR = "app_update"
+
+    private val TAG_PATTERN = Regex("(\\d{4})(\\d{2})(\\d{2})-(\\d{2})(\\d{2})")
+    private const val TIMEOUT_PROBE = 4000
+    private const val TIMEOUT_CONNECT = 12000
+    private const val TIMEOUT_READ = 12000
+    private const val TIMEOUT_DOWNLOAD_READ = 30000
+    private const val BUFFER_SIZE = 64 * 1024
+}
diff --git a/app/src/main/java/moe/ouom/neriplayer/update/UpdateCheckController.kt b/app/src/main/java/moe/ouom/neriplayer/update/UpdateCheckController.kt
new file mode 100644
index 00000000..529ecb70
--- /dev/null
+++ b/app/src/main/java/moe/ouom/neriplayer/update/UpdateCheckController.kt
@@ -0,0 +1,137 @@
+/*
+ * NeriPlayer - update check session (mobile build).
+ *
+ * This file is part of NeriPlayer (GPL-3.0-or-later).
+ */
+package moe.ouom.neriplayer.update
+
+import android.content.Context
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import moe.ouom.neriplayer.BuildConfig
+import java.time.LocalDate
+
+/**
+ * 「检查更新」弹窗当前要展示的内容。
+ *
+ * `null`（[UpdateCheckController.dialogState] 的初始值）表示不显示弹窗。
+ */
+internal sealed interface UpdateCheckUiState {
+    /** 正在请求 GitHub Release；从设置页点进来时立刻是这个状态。 */
+    data object Checking : UpdateCheckUiState
+
+    /** 检查成功，但没有比当前安装版本更新的 Release。 */
+    data object UpToDate : UpdateCheckUiState
+
+    /** 请求失败（无网络、镜像全挂、超时）。 */
+    data object Failed : UpdateCheckUiState
+
+    /** 查到新版本，可以下载。 */
+    data class Available(val latest: AppUpdateRepository.Latest) : UpdateCheckUiState
+}
+
+/** [UpdateCheckController.checkOnLaunch] 的结果，用来决定启动时要不要提示用户。 */
+internal enum class LaunchUpdateCheckResult {
+    /** 查到新版本，弹窗已经自己顶上来了 */
+    Updated,
+
+    /** 确认已是最新版本 */
+    UpToDate,
+
+    /** 请求失败，静默处理 */
+    Failed,
+
+    /** 今天已经查过，或已经有别的弹窗在用，直接跳过 */
+    Skipped
+}
+
+/**
+ * 更新检查的全局会话。
+ *
+ * 设置页点「版本」和启动时的一天一次检查都走这里，弹窗由 `NeriApp` 统一挂载
+ * （设置页自己不再持有弹窗状态，否则离开设置页窗口就没了）。
+ *
+ * 一次检查同一时刻只会有一个：用自增 [token] 丢弃过期结果，不用 `Job.cancel()` ——
+ * 取消会让 `runCatching` 把 `CancellationException` 一起吞掉，旧协程会继续往下跑。
+ */
+internal object UpdateCheckController {
+
+    private const val PREFS_NAME = "app_update_check"
+    private const val KEY_LAST_CHECK_DAY = "last_check_epoch_day"
+
+    private val _dialogState = MutableStateFlow<UpdateCheckUiState?>(null)
+    val dialogState: StateFlow<UpdateCheckUiState?> = _dialogState.asStateFlow()
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+
+    /** 每次发起检查自增，结果回来时对不上就丢弃 */
+    private var token = 0
+
+    /**
+     * 设置页点「版本」：立刻把弹窗顶出来显示「更新检查中」，再在后台请求。
+     */
+    fun checkFromSettings() {
+        val myToken = ++token
+        _dialogState.value = UpdateCheckUiState.Checking
+        scope.launch {
+            val found = runCatching { AppUpdateRepository.fetchLatest() }
+                .getOrDefault(AppUpdateRepository.FetchResult.Failed)
+            if (myToken != token) return@launch
+            // 检查期间用户可能已经点了「关闭」，那就别再把窗口顶出来
+            if (_dialogState.value == null) return@launch
+            _dialogState.value = found.toUiState()
+        }
+    }
+
+    /**
+     * 启动时调用：同一自然日只查一次。
+     *
+     * 只有查到新版本才自己弹窗；其余情况把结果交回调用方（去 Toast 或静默）。
+     * 「今天查过了」的标记在发请求之前就写下去 —— 网络失败也占掉今天的额度，
+     * 否则开机没网时会每次冷启动都重试一遍。
+     */
+    suspend fun checkOnLaunch(context: Context): LaunchUpdateCheckResult {
+        if (_dialogState.value != null) return LaunchUpdateCheckResult.Skipped
+        val appContext = context.applicationContext
+        val prefs = appContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+        val today = LocalDate.now().toEpochDay()
+        if (prefs.getLong(KEY_LAST_CHECK_DAY, Long.MIN_VALUE) == today) {
+            return LaunchUpdateCheckResult.Skipped
+        }
+        prefs.edit().putLong(KEY_LAST_CHECK_DAY, today).apply()
+
+        val myToken = ++token
+        val found = runCatching { AppUpdateRepository.fetchLatest() }
+            .getOrDefault(AppUpdateRepository.FetchResult.Failed)
+        if (myToken != token) return LaunchUpdateCheckResult.Skipped
+        return when (val state = found.toUiState()) {
+            is UpdateCheckUiState.Available -> {
+                _dialogState.value = state
+                LaunchUpdateCheckResult.Updated
+            }
+            UpdateCheckUiState.UpToDate -> LaunchUpdateCheckResult.UpToDate
+            else -> LaunchUpdateCheckResult.Failed
+        }
+    }
+
+    fun dismiss() {
+        _dialogState.value = null
+    }
+
+    private fun AppUpdateRepository.FetchResult.toUiState(): UpdateCheckUiState = when (this) {
+        AppUpdateRepository.FetchResult.Failed -> UpdateCheckUiState.Failed
+        // 没有手机版 Release 也等于「没得更新」，别当成错误
+        AppUpdateRepository.FetchResult.NotFound -> UpdateCheckUiState.UpToDate
+        is AppUpdateRepository.FetchResult.Found ->
+            if (latest.versionCode <= BuildConfig.VERSION_CODE) {
+                UpdateCheckUiState.UpToDate
+            } else {
+                UpdateCheckUiState.Available(latest)
+            }
+    }
+}
