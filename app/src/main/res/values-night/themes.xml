<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.NeriPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 不要关掉启动预览窗口，否则冷启动期间用户只能看到纯黑屏 -->
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.NeriPlayer" parent="Base.Theme.NeriPlayer" />

    <style name="Theme.NeriPlayer.Starting" parent="Theme.NeriPlayer">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
